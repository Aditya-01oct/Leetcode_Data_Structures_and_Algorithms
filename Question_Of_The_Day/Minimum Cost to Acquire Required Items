class Solution {
    public long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {
        if (costBoth <= cost1 + cost2){
            long costOfBiggerNeed = Math.max(need1, need2) == need1 ? Math.min(cost1, costBoth) : Math.min(cost2, costBoth);
            return ((long)costOfBiggerNeed) * Math.abs(need1 - need2) + Math.min(need1, need2) * ((long)costBoth);
        }
        return ((long)cost1) * need1 + ((long)cost2) * need2;
    }
}
